# Local dev. On AWS these become Lambda / Beanstalk environment variables.
AWS_REGION=us-east-1
TABLE_NAME=rosca
JWT_SECRET=change-me-locally

# --- local mode -------------------------------------------------------------
# Set this to run against DynamoDB Local (npm run dynamo). Leave it unset to
# talk to the real DynamoDB in your Learner Lab account.
DYNAMO_ENDPOINT=http://localhost:8010

API_BASE=http://localhost:4010
API_PORT=4010
PORT=3010

# --- AWS only ---------------------------------------------------------------
EVIDENCE_BUCKET=rosca-evidence-CHANGEME
ANALYTICS_BUCKET=rosca-analytics-CHANGEME
CDN_DOMAIN=
GLUE_DATABASE=rosca_analytics
GLUE_CRAWLER=rosca-ledger-crawler
ATHENA_WORKGROUP=primary
LAB_ROLE_ARN=
ALLOWED_ORIGIN=*
