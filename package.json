{
  "name": "rosca-cloud",
  "version": "1.0.0",
  "description": "Digital rotating savings and credit association (ROSCA) platform on AWS",
  "main": "api/index.js",
  "scripts": {
    "dev": "node --env-file=.env dev.js",
    "web": "node --env-file=.env web/server.js",
    "test": "node test/test.js",
    "bootstrap": "node --env-file=.env scripts/bootstrap.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "package:api": "powershell -NoProfile -Command \"Compress-Archive -Path api,node_modules,package.json -DestinationPath dist-api.zip -Force\"",
    "package:web": "powershell -NoProfile -Command \"Compress-Archive -Path web,node_modules,package.json,Procfile -DestinationPath dist-web.zip -Force\"",
    "dynamo": "docker run -d --rm -p 8010:8000 --name hui-dynamo amazon/dynamodb-local",
    "dynamo:stop": "docker rm -f hui-dynamo"
  },
  "dependencies": {
    "@aws-sdk/client-athena": "^3.700.0",
    "@aws-sdk/client-dynamodb": "^3.700.0",
    "@aws-sdk/client-glue": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-dynamodb": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2"
  }
}